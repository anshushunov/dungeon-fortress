{
  "mcpServers": {
    "dungeon-fortress-domain": {
      "type": "stdio",
      "command": "cmd",
      "args": [
        "/c",
        "${CLAUDE_PROJECT_DIR:-.}\\scripts\\domain-mcp-server.cmd"
      ],
      "env": {
        "DOTNET_NOLOGO": "1",
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
      }
    },
    "dungeon-fortress-editor": {
      "type": "http",
      "url": "http://127.0.0.1:29541/mcp"
    }
  }
}
