{
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(git diff:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(git show:*)",
      "Bash(gh issue view:*)",
      "Bash(wc:*)",
      "Bash(fd:*)",
      "Bash(gh pr list:*)",
      "Bash(git rev-parse:*)",
      "Bash(gh issue list:*)"
    ],
    "deny": [
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)",
      "Bash(rg *--pre*)",
      "Bash(rg *--hostname-bin*)",
      "Bash(fd *--exec*)",
      "Bash(fd *-x*)",
      "Bash(fd *-X*)"
    ]
  }
}
