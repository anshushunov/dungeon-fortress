; Engine configuration file.
; Prefer editing through documented text changes during this spike.

config_version=5

[application]

config/name="Dungeon Fortress — deterministic spike"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]

; The authored baseline remains 1280x720: 960x540 could not hold the HUD text at
; its worst frame. ADR 0008 makes the actual capture size an explicit launch
; parameter and keeps the HUD in its own CanvasLayer.
;
; This size is the design rectangle and the fallback, not what a player gets.
; A launch that declares no --frame-size sizes its own window from the screen
; and picks a UI scale to match; see "Startup frame and UI scale" in Main.cs and
; docs/engineering/ENVIRONMENT_SETUP.md. Headless runs and displays smaller than
; this rectangle keep it unchanged.
;
; "expand" supports aspect-ratio changes. For an explicit --frame-size, Main also
; sets that value as the logical content size, so a same-aspect larger frame
; exposes more world instead of scaling the old frame up. Reproducibility comes
; from --frame-size, --camera-position, --camera-zoom and --ui-scale on every
; screenshot command. Main.AssertLabelsFit measures the live layout plus several
; frame/UI-scale pairs on every run.
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="DungeonFortress.Game"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_mcp/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.071, 1)
